# Copy to .env and fill in. Never commit the filled-in copy.

# Password for the postgres superuser. Must match the POSTGRES_PASSWORD key of
# the Modal secret named spend-postgres.
SPEND_PG_PASSWORD=

# Modal credentials. Only needed on a machine that has no ~/.modal.toml,
# such as CI. Locally, `modal token new` writes the profile instead.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal profile to use out of ~/.modal.toml. Defaults to "default".
MODAL_PROFILE=

# Seconds between pg_dump snapshots to the volume. Defaults to 600.
SPEND_PG_DUMP_INTERVAL=
